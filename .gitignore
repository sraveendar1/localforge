venv/
# Secrets. Keys normally live in ~/.config/localforge/config.env (outside the
# repo entirely), but LOCALFORGE_CONFIG_DIR can point anywhere -- including
# here -- so ignore every .env shape, not just a bare ".env".
.env
*.env
.env.*
config.env
dist/
build/
*.spec
# The sidecar binary scripts/build_sidecar.sh produces: large (~75MB),
# platform-specific, and fully regenerable -- never committed.
desktop/src-tauri/binaries/
.pytest_cache/
.mypy_cache/
.DS_Store
*.log
localforge_output/
