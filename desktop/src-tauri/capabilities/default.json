{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-open",
    "opener:default"
  ]
}
